# ==============================================================================
# SOUNDING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Bitget Hackathon Qwen API Key (for serverless proxy and local Node CLI tests)
BITGET_QWEN_API_KEY=your_bitget_qwen_api_key_here

# Bitget Gateway Base URL (OpenAI-compatible chat completions endpoint)
BITGET_GATEWAY_URL=https://hackathon.bitgetops.com/v1

# Default LLM Model
BITGET_MODEL=qwen3.8-max

